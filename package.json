{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=5000",
        "hot": "mix watch --hot",
        "stg": "cross-env ENV_FILE=./.env.stg npm run production",
        "prod": "cross-env ENV_FILE=./.env.prod npm run production",
        "production": "mix --production",
